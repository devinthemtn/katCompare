#!/bin/sh
# katcmp-win: run the Windows build of katcmp from inside WSL.
#
# Arguments that are existing paths are translated to Windows paths, so
# "katcmp-win ./a ./b" works the same as "katcmp ./a ./b".
#
# @WIN_DIR@ is replaced by "task install" with the Windows install directory.
WIN_DIR="@WIN_DIR@"

usage() {
	cat <<'EOF'
katcmp-win: run the Windows build of katCompare from inside WSL.

Usage:
  katcmp-win [left_path] [right_path]          Windows GUI, returns immediately
  katcmp-win --wait [left_path] [right_path]   Windows GUI, returns when its window closes
  katcmp-win --tui [args]                      Windows TUI in this terminal

Options:
  --wait       Keep running until the GUI window closes
  --tui        Run the TUI instead of the GUI (see: katcmp-win --tui --help)
  -h, --help   Show this help

Paths that exist are converted to Windows paths automatically.

Use --wait when another program runs katcmp-win as its diff tool. Those programs
delete their temporary files as soon as the command returns, so without --wait
the files can be gone before the GUI reads them. For example:

  git config --global difftool.katcmp.cmd 'katcmp-win --wait "$LOCAL" "$REMOTE"'
  diff_tool = 'katcmp-win --wait "$LOCAL" "$REMOTE"'     # katbackup config.toml
EOF
}

exe="$WIN_DIR/katcmp-gui.exe"
gui=1
wait=0
while :; do
	case "$1" in
	--tui)
		gui=0
		exe="$WIN_DIR/katcmp.exe"
		shift
		;;
	--wait)
		wait=1
		shift
		;;
	-h | --help)
		# After --tui, fall through so katcmp.exe prints its own help.
		[ "$gui" = 0 ] && break
		usage
		exit 0
		;;
	*)
		break
		;;
	esac
done

if [ ! -x "$exe" ]; then
	echo "katcmp-win: $exe not found (re-run 'task install')" >&2
	exit 1
fi

for arg do
	shift
	if [ -e "$arg" ]; then
		arg=$(wslpath -aw "$arg")
	fi
	set -- "$@" "$arg"
done

if [ "$gui" = 0 ]; then
	exec "$exe" "$@"
fi
if [ "$wait" = 1 ]; then
	exec "$exe" "$@" >/dev/null 2>&1
fi
"$exe" "$@" >/dev/null 2>&1 &
